# Pip runs offline; no inference API keys are needed.
# Copy to .env and fill in locally. Never commit .env, keystores, or service-account files.

# Host for model pack downloads (decided in P1)
MODEL_PACK_BASE_URL=

# URL of the SHA-256 manifest used to verify downloaded model packs
MODEL_PACK_SHA256_MANIFEST_URL=

# Local path to the upload keystore (the keystore itself is never committed)
ANDROID_KEYSTORE_PATH=

# Key alias inside the upload keystore
ANDROID_KEYSTORE_ALIAS=

# Local path to a Play service-account JSON; only for publishing automation (optional)
PLAY_SERVICE_ACCOUNT_JSON_PATH=
