# Bibi runs offline; no inference API keys are needed.
# Copy to .env and fill in locally. Never commit .env, keystores, or service-account files.

# --- App / release ---

# Host for model pack downloads (decided in P1)
MODEL_PACK_BASE_URL=

# URL of the SHA-256 manifest used to verify downloaded model packs
MODEL_PACK_SHA256_MANIFEST_URL=

# Release signing (docs/release.md). Gradle reads these from ~/.gradle/gradle.properties,
# not from .env; they are listed here only so the names are documented. Never commit values.
BIBI_UPLOAD_STORE_FILE=
BIBI_UPLOAD_STORE_PASSWORD=
BIBI_UPLOAD_KEY_ALIAS=
BIBI_UPLOAD_KEY_PASSWORD=

# Local path to a Play service-account JSON; only for publishing automation (optional)
PLAY_SERVICE_ACCOUNT_JSON_PATH=

# --- Developer tooling only (never shipped in the app) ---
# Claude Code reads these from your shell environment, not from this file: export them in your shell profile.

# Context7 docs MCP key from context7.com/dashboard (optional; raises rate limits)
CONTEXT7_API_KEY=

# 21st MCP key from 21st.dev/mcp (UI inspiration search)
API_KEY_21ST=

# Strix: model id for the security scanner, e.g. a provider/model string from docs.strix.ai
STRIX_LLM=

# Strix: API key for the provider named in STRIX_LLM
LLM_API_KEY=
