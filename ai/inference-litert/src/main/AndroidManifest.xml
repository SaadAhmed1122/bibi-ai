<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline only: MediaPipe's tasks-core would bring these in through datatransport, which the
         build excludes; these lines keep the merged manifest free of them in any case. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application>
        <!--
            The LLM runs in its own process (PRD §11.3, SPEC-inference.md), so a crash or a
            low-memory kill of the model does not take the UI down.
        -->
        <service
            android:name=".InferenceService"
            android:exported="false"
            android:process=":inference" />
    </application>
</manifest>
