<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the model download be tested from a laptop through `adb reverse`
     (plain HTTP to 127.0.0.1). Release builds keep the default: HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
