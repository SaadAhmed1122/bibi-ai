<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for AlarmClock.ACTION_SET_ALARM and ACTION_SET_TIMER (developer.android.com,
         "Common intents" → Alarm clock; AlarmClock reference says SET_TIMER requires it too). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Flashlight via CameraManager.setTorchMode; no CAMERA permission is listed for it. The flash
         is optional so the app still installs on devices without one. -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!-- Package visibility (Android 11+): only the intent signatures this spike resolves.
         No QUERY_ALL_PACKAGES (PRD §16.3). No CALL_PHONE, SMS, call log, contacts (PRD 0.9). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
